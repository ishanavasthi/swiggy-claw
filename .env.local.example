# --- LLM provider -----------------------------------------------------------
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
# 3/3 tool routing + completes multi-round chains. ~40s for a 3-hop turn.
# Faster alternative (~8s) but stops after one tool hop: openai/gpt-oss-20b
LLM_MODEL=deepseek-ai/deepseek-v4-pro

# To switch back to Groq: set LLM_PROVIDER=groq and supply GROQ_API_KEY.
# GROQ_API_KEY=

# --- Swiggy ------------------------------------------------------------------
SWIGGY_USE_MOCK=true
SESSION_SECRET=
